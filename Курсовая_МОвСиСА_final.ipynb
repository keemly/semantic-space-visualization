        "community_map = {}\n",
        "for i, comm in enumerate(communities):\n",
        "    for node in comm:\n",
        "        community_map[node] = i\n",
        "\n",
        "palette = sns.color_palette(\"tab10\", n_colors=len(communities))\n",
        "node_colors = [palette[community_map[node]] for node in G_words_sub.nodes()]\n",
        "\n",
        "plt.figure(figsize=(14, 10))\n",
        "pos = nx.spring_layout(G_words_sub, seed=42, k=0.9)\n",
        "\n",
        "node_sizes = [300 + 30 * G_words_sub.degree(n) for n in G_words_sub.nodes()]\n",
        "edge_widths = [0.5 + 0.15 * G_words_sub[u][v][\"weight\"] for u, v in G_words_sub.edges()]\n",
        "\n",
        "nx.draw_networkx_nodes(G_words_sub, pos, node_size=node_sizes, node_color=node_colors, alpha=0.9)\n",
        "nx.draw_networkx_edges(G_words_sub, pos, width=edge_widths, alpha=0.35)\n",
        "nx.draw_networkx_labels(G_words_sub, pos, font_size=9)\n",
        "\n",
        "plt.title(\"Сообщества в графе совместной встречаемости содержательных слов\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
      ],
      "metadata": {
