        "    axes[0].set_xlabel(\"Epoch\")\n",
        "    axes[0].legend()\n",
        "\n",
        "    axes[1].plot(history_df[\"epoch\"], history_df[\"train_f1\"], label=\"Train Macro-F1\")\n",
        "    axes[1].plot(history_df[\"epoch\"], history_df[\"val_f1\"], label=\"Val Macro-F1\")\n",
        "    axes[1].set_title(f\"{title}: Macro-F1\")\n",
