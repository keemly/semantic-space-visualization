    {
      "cell_type": "code",
      "source": [
        "def plot_knn_graph(G, labels, title):\n",
        "    plt.figure(figsize=(12, 9))\n",
        "    pos = nx.spring_layout(G, seed=42, k=0.35)\n",
        "\n",
        "    palette = sns.color_palette(\"tab10\", n_colors=len(set(labels)))\n",
        "    node_colors = [palette[labels[n]] for n in G.nodes()]\n",
        "\n",
        "    nx.draw_networkx_nodes(G, pos, node_size=80, node_color=node_colors, alpha=0.85)\n",
        "    nx.draw_networkx_edges(G, pos, alpha=0.25, width=0.7)\n",
        "\n",
        "    handles = [\n",
        "        plt.Line2D([0], [0], marker='o', color='w', label=label_names[i],\n",
        "                   markerfacecolor=palette[i], markersize=8)\n",
        "        for i in sorted(set(labels))\n",
        "    ]\n",
        "    plt.legend(handles=handles, title=\"Class\")\n",
        "    plt.title(title)\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()"
      ],
      "metadata": {
        "id": "gwBqcl8rYLXH"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
