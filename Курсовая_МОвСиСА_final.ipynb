      "source": [
        "Проверка стратификации для понимания баланса/дисбаланса классов в разбиениях:"
      ],
      "metadata": {
        "id": "WBaXXodNOAuZ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def class_distribution_table(df, name):\n",
        "    tmp = (\n",
        "        df[\"label_name\"]\n",
        "        .value_counts(normalize=True)\n",
        "        .sort_index()\n",
        "        .mul(100)\n",
        "        .round(2)\n",
        "        .rename(name)\n",
        "    )\n",
        "    return tmp\n",
        "\n",
        "split_class_dist = pd.concat(\n",
        "    [\n",
        "        class_distribution_table(train_df, \"Train (%)\"),\n",
        "        class_distribution_table(val_df, \"Validation (%)\"),\n",
        "        class_distribution_table(test_df, \"Test (%)\"),\n",
        "    ],\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "split_class_dist"
      ],
      "metadata": {
        "colab": {
