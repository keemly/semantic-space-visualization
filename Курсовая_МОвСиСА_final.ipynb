        "from scipy.sparse import hstack, csr_matrix\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "scaler_graph = StandardScaler()\n",
        "\n",
        "X_train_graph_scaled = scaler_graph.fit_transform(train_graph_features)\n",
        "X_val_graph_scaled = scaler_graph.transform(val_graph_features)\n",
        "X_test_graph_scaled = scaler_graph.transform(test_graph_features)\n",
        "\n",
        "X_train_tfidf_graph = hstack([X_train_tfidf, csr_matrix(X_train_graph_scaled)])\n",
        "X_val_tfidf_graph = hstack([X_val_tfidf, csr_matrix(X_val_graph_scaled)])\n",
        "X_test_tfidf_graph = hstack([X_test_tfidf, csr_matrix(X_test_graph_scaled)])\n",
        "\n",
