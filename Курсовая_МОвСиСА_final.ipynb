      "cell_type": "markdown",
      "source": [
        "Граф семантической близости текстов на основе эмбеддингов"
      ],
      "metadata": {
        "id": "nA04SYA_YF20"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.neighbors import NearestNeighbors"
      ],
      "metadata": {
        "id": "2Y1_i1VfX8Qg"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def build_knn_graph(embeddings, labels, n_neighbors=5, max_points=300, random_state=42):\n",
        "    rng = np.random.RandomState(random_state)\n",
        "    idx = np.arange(len(embeddings))\n",
        "    if len(idx) > max_points:\n",
        "        idx = rng.choice(idx, size=max_points, replace=False)\n",
        "\n",
        "    X = embeddings[idx]\n",
        "    y = np.array(labels)[idx]\n",
        "\n",
        "    nn_model = NearestNeighbors(n_neighbors=n_neighbors + 1, metric=\"cosine\")\n",
        "    nn_model.fit(X)\n",
        "    distances, indices = nn_model.kneighbors(X)\n",
        "\n",
        "    G = nx.Graph()\n",
        "\n",
        "    for i in range(len(X)):\n",
        "        G.add_node(i, label=int(y[i]))\n",
        "\n",
        "    for i in range(len(X)):\n",
        "        for j_idx, dist in zip(indices[i][1:], distances[i][1:]):\n",
        "            sim = 1 - dist\n",
        "            G.add_edge(i, int(j_idx), weight=float(sim))\n",
        "\n",
        "    return G, X, y"
      ],
      "metadata": {
        "id": "FSoWl33KYB-H"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "G_sbert_knn, X_sbert_sub, y_sbert_sub = build_knn_graph(\n",
        "    X_test_sbert,\n",
        "    y_test,\n",
        "    n_neighbors=5,\n",
        "    max_points=250,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "print(\"Узлов:\", G_sbert_knn.number_of_nodes())\n",
        "print(\"Рёбер:\", G_sbert_knn.number_of_edges())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
