    {
      "cell_type": "code",
      "source": [
        "top_nodes = word_degree_df.head(40)[\"word\"].tolist()\n",
        "G_words_sub = G_words.subgraph(top_nodes).copy()\n",
        "\n",
        "plt.figure(figsize=(14, 10))\n",
        "pos = nx.spring_layout(G_words_sub, seed=42, k=0.9)\n",
        "\n",
        "node_sizes = [300 + 30 * G_words_sub.degree(n) for n in G_words_sub.nodes()]\n",
        "edge_widths = [0.5 + 0.15 * G_words_sub[u][v][\"weight\"] for u, v in G_words_sub.edges()]\n",
        "\n",
        "nx.draw_networkx_nodes(G_words_sub, pos, node_size=node_sizes)\n",
        "nx.draw_networkx_edges(G_words_sub, pos, width=edge_widths, alpha=0.5)\n",
        "nx.draw_networkx_labels(G_words_sub, pos, font_size=9)\n",
        "\n",
        "plt.title(\"Граф совместной встречаемости содержательных слов\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
