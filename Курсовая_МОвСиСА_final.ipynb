    {
      "cell_type": "markdown",
      "source": [
        "Сравнение семантического пространства до и после обучения классификационной головы\n",
        "\n",
        "Для более точной интерпретации результатов важно сопоставить:\n",
        "- исходное пространство предобученных Sentence-BERT эмбеддингов;\n",
        "- скрытое пространство, формируемое лучшей классификационной моделью после обучения.\n",
        "\n",
        "Такое сравнение позволяет проследить,\n",
        "как обучение изменяет геометрию представлений текста\n",
        "и делает пространство более согласованным с задачей тематической классификации."
      ],
      "metadata": {
        "id": "5qPg87LVfVIf"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "функция для парного сравнения"
      ],
      "metadata": {
        "id": "u_3TJYtLfQBa"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def plot_before_after_spaces(\n",
        "    X_before,\n",
        "    X_after,\n",
        "    y,\n",
        "    title_before=\"Before\",\n",
        "    title_after=\"After\",\n",
        "    method=\"umap\",\n",
        "    max_points=3000,\n",
        "    random_state=42\n",
        "):\n",
        "    rng = np.random.RandomState(random_state)\n",
        "    idx = np.arange(len(y))\n",
        "    if len(idx) > max_points:\n",
        "        idx = rng.choice(idx, size=max_points, replace=False)\n",
        "\n",
        "    X_before_sub = X_before[idx]\n",
        "    X_after_sub = X_after[idx]\n",
        "    y_sub = np.array(y)[idx]\n",
        "\n",
        "    if method == \"pca\":\n",
        "        reducer_before = PCA(n_components=2, random_state=random_state)\n",
        "        reducer_after = PCA(n_components=2, random_state=random_state)\n",
        "        X_before_2d = reducer_before.fit_transform(X_before_sub)\n",
        "        X_after_2d = reducer_after.fit_transform(X_after_sub)\n",
        "    elif method == \"tsne\":\n",
        "        reducer_before = TSNE(n_components=2, random_state=random_state, init=\"pca\", learning_rate=\"auto\")\n",
        "        reducer_after = TSNE(n_components=2, random_state=random_state, init=\"pca\", learning_rate=\"auto\")\n",
        "        X_before_2d = reducer_before.fit_transform(X_before_sub)\n",
        "        X_after_2d = reducer_after.fit_transform(X_after_sub)\n",
        "    elif method == \"umap\":\n",
        "        reducer_before = umap.UMAP(n_components=2, random_state=random_state)\n",
        "        reducer_after = umap.UMAP(n_components=2, random_state=random_state)\n",
        "        X_before_2d = reducer_before.fit_transform(X_before_sub)\n",
        "        X_after_2d = reducer_after.fit_transform(X_after_sub)\n",
        "    else:\n",
        "        raise ValueError(\"Unknown method\")\n",
        "\n",
        "    df_before = pd.DataFrame({\n",
        "        \"x\": X_before_2d[:, 0],\n",
        "        \"y\": X_before_2d[:, 1],\n",
        "        \"label\": [label_names[i] for i in y_sub]\n",
        "    })\n",
        "\n",
        "    df_after = pd.DataFrame({\n",
        "        \"x\": X_after_2d[:, 0],\n",
        "        \"y\": X_after_2d[:, 1],\n",
        "        \"label\": [label_names[i] for i in y_sub]\n",
        "    })\n",
        "\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "\n",
        "    sns.scatterplot(\n",
        "        data=df_before,\n",
        "        x=\"x\", y=\"y\",\n",
        "        hue=\"label\",\n",
        "        alpha=0.7,\n",
        "        s=35,\n",
        "        ax=axes[0]\n",
        "    )\n",
        "    axes[0].set_title(title_before)\n",
        "    axes[0].legend().remove()\n",
        "\n",
        "    sns.scatterplot(\n",
        "        data=df_after,\n",
        "        x=\"x\", y=\"y\",\n",
        "        hue=\"label\",\n",
        "        alpha=0.7,\n",
        "        s=35,\n",
        "        ax=axes[1]\n",
        "    )\n",
        "    axes[1].set_title(title_after)\n",
        "\n",
        "    handles, labels = axes[1].get_legend_handles_labels()\n",
        "    axes[1].legend(handles=handles, labels=labels, bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
        "\n",
        "    plt.suptitle(f\"Сравнение пространств ({method.upper()})\", y=1.02, fontsize=14)\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ],
      "metadata": {
        "id": "XInjcTY6fWhz"
      },
      "execution_count": null,
      "outputs": []
    },
