    {
      "cell_type": "code",
      "source": [
        "def plot_embedding_space(\n",
        "    X,\n",
        "    y,\n",
        "    title,\n",
        "    method=\"umap\",\n",
        "    max_points=3000,\n",
        "    random_state=42,\n",
        "    umap_n_neighbors=15,\n",
        "    tsne_perplexity=30\n",
        "):\n",
        "    rng = np.random.RandomState(random_state)\n",
        "    idx = np.arange(len(X))\n",
        "    if len(X) > max_points:\n",
        "        idx = rng.choice(idx, size=max_points, replace=False)\n",
        "\n",
        "    X_sub = X[idx]\n",
        "    y_sub = np.array(y)[idx]\n",
        "\n",
        "    if method == \"pca\":\n",
        "        reducer = PCA(n_components=2, random_state=random_state)\n",
        "        X_2d = reducer.fit_transform(X_sub)\n",
        "    elif method == \"tsne\":\n",
        "        reducer = TSNE(\n",
        "            n_components=2,\n",
        "            random_state=random_state,\n",
        "            init=\"pca\",\n",
        "            learning_rate=\"auto\",\n",
        "            perplexity=tsne_perplexity\n",
        "        )\n",
        "        X_2d = reducer.fit_transform(X_sub)\n",
        "    elif method == \"umap\":\n",
        "        reducer = umap.UMAP(\n",
        "            n_components=2,\n",
        "            random_state=random_state,\n",
        "            n_neighbors=umap_n_neighbors\n",
        "        )\n",
        "        X_2d = reducer.fit_transform(X_sub)\n",
        "    else:\n",
        "        raise ValueError(\"Unknown method\")\n",
        "\n",
        "    plot_df = pd.DataFrame({\n",
        "        \"x\": X_2d[:, 0],\n",
        "        \"y\": X_2d[:, 1],\n",
        "        \"label\": [label_names[i] for i in y_sub]\n",
        "    })\n",
        "\n",
        "    plt.figure(figsize=(9, 7))\n",
        "    sns.scatterplot(data=plot_df, x=\"x\", y=\"y\", hue=\"label\", alpha=0.7, s=35)\n",
        "    plt.title(title)\n",
        "    plt.legend()\n",
        "    plt.show()"
      ],
      "metadata": {
        "id": "vGNJmTgvRZc-"
      },
      "execution_count": null,
      "outputs": []
    },
