      "cell_type": "code",
      "source": [
        "tfidf_test_out = collect_predictions_and_features(tfidf_model, tfidf_test_loader, DEVICE)\n",
        "sbert_test_out = collect_predictions_and_features(sbert_model, sbert_test_loader, DEVICE)\n",
        "bilstm_test_out = collect_predictions_and_features(bilstm_model, seq_test_loader, DEVICE)"
      ],
