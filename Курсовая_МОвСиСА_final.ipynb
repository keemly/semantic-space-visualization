    {
      "cell_type": "markdown",
      "source": [
        "Мы видим, что длина словаря 30000 слов покрывает 98.85% всех токенов, нам этого достаточно, поэтому берём `vocab_size_limit = 30000`"
      ],
      "metadata": {
        "id": "SaRzzUVsIvr5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import Counter\n",
        "\n",
        "def tokenize(text):\n",
        "    return text.split()\n",
        "\n",
        "counter = Counter()\n",
        "for text in X_train_text:\n",
        "    counter.update(tokenize(text))\n",
        "\n",
        "vocab_size_limit = 30000\n",
        "special_tokens = [\"<PAD>\", \"<UNK>\"]\n",
        "\n",
        "most_common_tokens = [token for token, _ in counter.most_common(vocab_size_limit - len(special_tokens))]\n",
        "itos = special_tokens + most_common_tokens\n",
        "stoi = {token: idx for idx, token in enumerate(itos)}\n",
        "\n",
        "PAD_IDX = stoi[\"<PAD>\"]\n",
        "UNK_IDX = stoi[\"<UNK>\"]\n",
        "\n",
        "print(\"Размер словаря:\", len(stoi))\n",
        "print(\"PAD_IDX:\", PAD_IDX)\n",
        "print(\"UNK_IDX:\", UNK_IDX)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VapnT72AKIi-",
        "outputId": "2831e3e1-f944-4b59-ac0b-a24ba4b07800"
