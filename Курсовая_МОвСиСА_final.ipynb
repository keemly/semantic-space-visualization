    {
      "cell_type": "markdown",
      "source": [
        "Значение `MAX_LEN = 64` выбрано на основе анализа распределения длины текстов.\n",
        "Оно покрывает подавляющее большинство коротких новостных сообщений и позволяет,\n",
        "с одной стороны, сохранить основную смысловую информацию текста,\n",
        "а с другой — ограничить вычислительные затраты при обучении последовательностной модели."
      ],
      "metadata": {
        "id": "1E_tvptBH5qF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "MAX_LEN = 64\n",
        "\n",
        "def encode_text(text, stoi, max_len=MAX_LEN):\n",
        "    tokens = tokenize(text)\n",
        "    ids = [stoi.get(token, UNK_IDX) for token in tokens[:max_len]]\n",
        "    if len(ids) < max_len:\n",
        "        ids += [PAD_IDX] * (max_len - len(ids))\n",
        "    return ids\n",
        "\n",
        "X_train_seq = np.array([encode_text(text, stoi) for text in X_train_text])\n",
        "X_val_seq = np.array([encode_text(text, stoi) for text in X_val_text])\n",
        "X_test_seq = np.array([encode_text(text, stoi) for text in X_test_text])\n",
        "\n",
        "print(\"BiLSTM input shapes:\")\n",
        "print(\"Train:\", X_train_seq.shape)\n",
        "print(\"Val:\", X_val_seq.shape)\n",
        "print(\"Test:\", X_test_seq.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "30ZmGh2RKVMD",
        "outputId": "a808c12c-8f65-499f-9662-133d77e8dfc9"
      },
