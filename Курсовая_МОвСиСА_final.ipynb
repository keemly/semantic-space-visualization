    },
    {
      "cell_type": "code",
      "source": [
        "community_rows = []\n",
        "\n",
        "for i, comm in enumerate(communities, start=1):\n",
        "    sorted_nodes = sorted(\n",
        "        list(comm),\n",
        "        key=lambda x: G_words_sub.degree(x),\n",
        "        reverse=True\n",
        "    )\n",
        "    community_rows.append({\n",
        "        \"Сообщество\": i,\n",
        "        \"Размер\": len(comm),\n",
        "        \"Ключевые слова\": \", \".join(sorted_nodes[:10])\n",
        "    })\n",
        "\n",
        "community_df = pd.DataFrame(community_rows)\n",
        "community_df"
