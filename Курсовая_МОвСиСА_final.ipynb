      "source": [
        "tsne_candidates = [5, 10, 20, 30, 40, 50]\n",
        "tsne_search_results = []\n",
        "\n",
        "sample_idx = np.random.RandomState(42).choice(len(X_val_sbert), size=min(2000, len(X_val_sbert)), replace=False)\n",
        "X_val_sbert_sample = X_val_sbert[sample_idx]\n",
        "y_val_sample = y_val[sample_idx]\n",
        "\n",
        "for perplexity in tsne_candidates:\n",
        "    reducer = TSNE(\n",
        "        n_components=2,\n",
        "        perplexity=perplexity,\n",
        "        random_state=42,\n",
        "        init=\"pca\",\n",
        "        learning_rate=\"auto\"\n",
        "    )\n",
        "    X_val_tsne = reducer.fit_transform(X_val_sbert_sample)\n",
        "    score = silhouette_score(X_val_tsne, y_val_sample)\n",
        "\n",
        "    tsne_search_results.append({\n",
        "        \"perplexity\": perplexity,\n",
        "        \"silhouette_score\": score\n",
        "    })\n",
        "\n",
        "tsne_search_df = pd.DataFrame(tsne_search_results).sort_values(\"silhouette_score\", ascending=False)\n",
        "tsne_search_df"
      ],
