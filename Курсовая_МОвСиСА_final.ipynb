    {
      "cell_type": "markdown",
      "source": [
        "вычисление Sentence-BERT эмбеддингов"
      ],
      "metadata": {
        "id": "6_SH_B6WOqvW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sentence_transformers import SentenceTransformer\n",
        "\n",
        "sbert_encoder = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\", device=str(DEVICE))\n",
        "\n",
        "X_train_sbert = sbert_encoder.encode(\n",
        "    X_train_text,\n",
        "    batch_size=256,\n",
        "    show_progress_bar=True,\n",
        "    convert_to_numpy=True,\n",
        "    normalize_embeddings=True\n",
        ")\n",
        "\n",
        "X_val_sbert = sbert_encoder.encode(\n",
        "    X_val_text,\n",
        "    batch_size=256,\n",
        "    show_progress_bar=True,\n",
        "    convert_to_numpy=True,\n",
        "    normalize_embeddings=True\n",
        ")\n",
        "\n",
        "X_test_sbert = sbert_encoder.encode(\n",
        "    X_test_text,\n",
        "    batch_size=256,\n",
        "    show_progress_bar=True,\n",
        "    convert_to_numpy=True,\n",
        "    normalize_embeddings=True\n",
        ")\n",
        "\n",
        "print(X_train_sbert.shape, X_val_sbert.shape, X_test_sbert.shape)"
