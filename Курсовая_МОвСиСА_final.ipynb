        "id": "LzoBecoFNg5V"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"Исходная обучающая выборка AG News:\", train_raw.shape)\n",
        "print(\"Исходная тестовая выборка AG News:\", test_raw.shape)"
      ],
